# jev-ultrafast + BrowserOS neo + Vercel AI Gateway
# Secret lives in .envrc.local (gitignored):  export AI_GATEWAY_API_KEY=vck_...
source_env_if_exists .envrc.local

# Jev via Vercel AI Gateway (TypeSafe-compatible endpoint)
export TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
export TYPESAFE_MODEL=typesafe-ai/jev
export TYPESAFE_API_KEY="${AI_GATEWAY_API_KEY:-}"

# Text helper (TYPE_TEXT only) via the same gateway, OpenAI-compatible endpoint
export TEXT_MODEL_BASE_URL=https://ai-gateway.vercel.sh/v1
export TEXT_MODEL_API_KEY="${AI_GATEWAY_API_KEY:-}"
export TEXT_MODEL=inception/mercury-2.5
export TEXT_MODEL_REASONING=none

# BrowserOS neo CDP (Chromium remote debugging, bound by neo on this port)
export BU_CDP_URL=http://127.0.0.1:9110
